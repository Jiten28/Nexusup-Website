# Documentation only: settings reads environment variables, NOT this file automatically.
# Use `set -a; . ./.env; set +a` in a trusted local shell, or a secret manager.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SITE_URL=http://127.0.0.1:8000
DB_ENGINE=sqlite
ADS_TXT_ENABLED=0
# For an approved isolated MariaDB environment only:
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=<generate-a-long-random-secret>
# DJANGO_ALLOWED_HOSTS=<approved-staging-hostname>
# SITE_URL=https://<approved-staging-hostname>
# DB_ENGINE=mariadb
# DB_HOST=<approved-database-host>
# DB_PORT=3306
# DB_NAME=<new-django-database-not-wordpress>
# DB_USER=<least-privilege-django-user>
# DB_PASSWORD=<supply-securely>
