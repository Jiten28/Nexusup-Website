# Optional local development file.
# Copy to backend/.env; Django loads it with python-dotenv. Existing process/host
# variables always win. backend/.env is gitignored. Never put real secrets here.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
# sqlite = quick local start (needs DJANGO_DEBUG=1).  mariadb = MariaDB (see database/README.md).
DB_ENGINE=sqlite
# Optional absolute path for an isolated development/test database.
SQLITE_PATH=
# MariaDB: use the same values as database/.env. DB_HOST defaults to 127.0.0.1.
DB_NAME=nexusup
DB_USER=nexusup
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
ADS_TXT_ENABLED=0
# 1 allows fetching when YOU run a command or click Fetch in the admin (never on page views). Set 0 to freeze all fetching.
NEWS_FETCH_ENABLED=1
# Server-only NewsAPI credential. Do not add apiKey to a NewsSource URL.
NEWS_API_KEY=
# 1-5 pages of at most 100 provider results each; default intentionally bounded.
NEWS_API_MAX_PAGES=1
UTILITIES_NETWORK_ENABLED=0
# Commercial weather uses customer-api.open-meteo.com when this key is set.
OPEN_METEO_API_KEY=
# disabled | google | libre; private key stays on the server.
# Free translation: start backend/translate/compose.yaml, then set TRANSLATION_PROVIDER=libre
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=http://127.0.0.1:5000
# Local HTTP is restricted to loopback. Remote instances require public HTTPS.
TRANSLATION_TIMEOUT=15
# React/Vite is the canonical public site; use its exact local origin.
# PUBLIC_FRONTEND_MODE=legacy explicitly restores the retained Django templates.
PUBLIC_FRONTEND_MODE=react
FRONTEND_URL=http://localhost:5173
# Needed only when calling the API directly from a separate frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=1
COOKIE_SAMESITE=Lax
DB_TLS_REQUIRED=1
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
TRUST_PROXY_HTTPS=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
MEDIA_STORAGE=local
MEDIA_URL=/media/
STATIC_URL=/static/
# Optional absolute persistent paths: MEDIA_ROOT and STATIC_ROOT.
# Optional S3: install requirements-storage.txt and use standard private AWS
# credentials/role, AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME,
# AWS_S3_ENDPOINT_URL (optional), AWS_QUERYSTRING_AUTH=1.
API_ANON_RATE=120/minute
# Optional shared Redis URL for multi-worker caches and rate limits.
CACHE_URL=
LOG_LEVEL=INFO
