# NexusUp backend environment template
# Copy this file to: backend/.env
# Never commit backend/.env or put real credentials in this template.
# Django loads backend/.env via python-dotenv. Environment variables supplied by
# the process/hosting platform take precedence over values in this file.

# -----------------------------------------------------------------------------
# 1. Django and site settings
# -----------------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# 2. Database
# Local development: SQLite (DB credentials below may remain blank).
# Production: configure MariaDB and use private credentials from your host.
# -----------------------------------------------------------------------------
DB_ENGINE=sqlite
SQLITE_PATH=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
DB_TLS_REQUIRED=1
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

# -----------------------------------------------------------------------------
# 3. News ingestion
# Fetching is opt-in and must run through the scheduled management command,
# never from homepage requests. Keep disabled until sources/rights are reviewed.
# Do not put NewsAPI credentials in a NewsSource URL.
# -----------------------------------------------------------------------------
NEWS_FETCH_ENABLED=0
NEWS_API_KEY=
# Bounded to 1-5 pages; each provider page can contain up to 100 results.
NEWS_API_MAX_PAGES=1

# -----------------------------------------------------------------------------
# 4. Weather and network-backed utilities
# Keep disabled until the relevant integrations are implemented and tested.
# Commercial Open-Meteo API key is optional.
# -----------------------------------------------------------------------------
UTILITIES_NETWORK_ENABLED=0
OPEN_METEO_API_KEY=

# -----------------------------------------------------------------------------
# 5. Translation
# Supported backend setting values: disabled | google | libre.
# Keep disabled until a provider is deliberately configured and tested.
# For LibreTranslate, set the URL of your own trusted/self-hosted service if used.
# -----------------------------------------------------------------------------
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com

# -----------------------------------------------------------------------------
# 6. Frontend URLs, CORS, CSRF, and cookies
# These localhost values are for local development. Change them for deployment.
# CORS is only needed when the frontend calls the API from a separate origin.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=1
COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# 7. HTTPS / reverse-proxy security
# For local development these remain off. Configure carefully in production.
# -----------------------------------------------------------------------------
TRUST_PROXY_HTTPS=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# -----------------------------------------------------------------------------
# 8. Static files and uploaded media
# Optional absolute paths: MEDIA_ROOT and STATIC_ROOT.
# Optional S3 support: install requirements-storage.txt and configure private
# AWS credentials/role plus AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME,
# AWS_S3_ENDPOINT_URL (optional), AWS_QUERYSTRING_AUTH=1.
# -----------------------------------------------------------------------------
ADS_TXT_ENABLED=0
MEDIA_STORAGE=local
MEDIA_URL=/media/
STATIC_URL=/static/

# -----------------------------------------------------------------------------
# 9. Rate limits, cache, and logging
# CACHE_URL is optional; use a shared Redis URL for multi-worker deployments.
# -----------------------------------------------------------------------------
API_ANON_RATE=120/minute
CACHE_URL=
LOG_LEVEL=INFO
