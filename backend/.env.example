# Optional local development file.
# Copy to backend/.env; Django loads it with python-dotenv. Existing process/host
# variables always win. backend/.env is gitignored. Never put real secrets here.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
DB_ENGINE=sqlite
# Optional absolute path for an isolated development/test database.
SQLITE_PATH=
# Production uses DB_ENGINE=mariadb, DJANGO_DEBUG=0, HTTPS SITE_URL and private credentials.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
ADS_TXT_ENABLED=0
# Disabled until provider/rights review. Never fetch on homepage requests.
NEWS_FETCH_ENABLED=0
# Server-only NewsAPI credential. Do not add apiKey to a NewsSource URL.
NEWS_API_KEY=
# 1-5 pages of at most 100 provider results each; default intentionally bounded.
NEWS_API_MAX_PAGES=1
UTILITIES_NETWORK_ENABLED=0
# Commercial weather uses customer-api.open-meteo.com when this key is set.
OPEN_METEO_API_KEY=
# disabled | google | libre; private key stays on the server.
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com
FRONTEND_URL=http://127.0.0.1:5173
# Needed only when calling the API directly from a separate frontend origin.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=1
COOKIE_SAMESITE=Lax
DB_TLS_REQUIRED=1
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
TRUST_PROXY_HTTPS=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
MEDIA_STORAGE=local
MEDIA_URL=/media/
STATIC_URL=/static/
# Optional absolute persistent paths: MEDIA_ROOT and STATIC_ROOT.
# Optional S3: install requirements-storage.txt and use standard private AWS
# credentials/role, AWS_STORAGE_BUCKET_NAME, AWS_S3_REGION_NAME,
# AWS_S3_ENDPOINT_URL (optional), AWS_QUERYSTRING_AUTH=1.
API_ANON_RATE=120/minute
# Optional shared Redis URL for multi-worker caches and rate limits.
CACHE_URL=
LOG_LEVEL=INFO
