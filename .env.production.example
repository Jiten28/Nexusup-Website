# Copy privately to .env for Compose. Do not commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=news.example.com
SITE_URL=https://news.example.com
FRONTEND_URL=https://news.example.com
DB_ENGINE=mariadb
DB_NAME=nexusup
DB_USER=nexusup
DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_PRIVATE_ROOT_PASSWORD
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
# Compose overrides to 0 only for its isolated DB network. Remote DB: use TLS + CA.
DB_TLS_REQUIRED=1
DB_SSL_CA=
TRUST_PROXY_HTTPS=1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://news.example.com
CORS_ALLOW_CREDENTIALS=0
COOKIE_SAMESITE=Lax
MEDIA_STORAGE=local
MEDIA_URL=/media/
STATIC_URL=/static/
NEWS_FETCH_ENABLED=0
NEWS_API_KEY=
NEWS_API_MAX_PAGES=1
UTILITIES_NETWORK_ENABLED=0
OPEN_METEO_API_KEY=
TRANSLATION_PROVIDER=disabled
TRANSLATION_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com
LOG_LEVEL=INFO
ADS_TXT_ENABLED=0
# Optional host-provided shared cache. Keep any credential-bearing URL private.
CACHE_URL=
API_ANON_RATE=120/minute
# Start at zero. Raise only after all production hostnames are verified on HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
