{
  "name": "nexusup-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "demo": "vite --host 0.0.0.0 --mode demo",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "test:demo": "node tests/demo.cjs",
    "preview:demo": "vite preview --host 0.0.0.0 --outDir dist-demo"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "^6.3.0"
  }
}
